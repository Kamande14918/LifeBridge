# ENV = development
PORT=8000
CORS_ORIGINS=*

# Models
# Use the sentence-transformers hub id for the MiniLM embeddings (correct ID)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GENERATION_MODEL=google/flan-t5-base
MAX_NEW_TOKENS=256
TOP_K=5

# Data paths
DATA_DIR=data
INDEX_DIR=data/faiss_index

# Memory/Redis
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0
MEMORY_EXPIRY=3600

# Text to Speech
ENABLE_SERVER_TTS=false
TTS_OUTPUT_DIR=data/tts